# ETERNA full-service deployment — environment configuration
# Copy this file to .env and fill in all values before starting services.
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------

# Fully qualified domain name that Traefik will route traffic to.
ETERNA_HOST=eterna.example.com

# Docker network name (used by Traefik provider and the network definition).
NETWORK_NAME=eterna_net

# ---------------------------------------------------------------------------
# Local paths
# These directories are bind-mounted into the containers. Create them before
# starting services, or Docker will create them owned by root.
#
#   mkdir -p ./data/{storage,ldap,log}
#   mkdir -p ./integration/{drop,transfer,reports}
#   mkdir -p ./config/{theme,ldap,plugins,traefik,sftp,cas}
# ---------------------------------------------------------------------------

# Base path for ETERNA data (storage, LDAP directory, logs).
DATA_PATH=./data

# Base path for integration directories (drop folder, transfer, reports).
INTEGRATION_PATH=./integration

# Base path for site-specific configuration files.
CONFIG_PATH=./config

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Shared secret for the distributed API (used when running multiple ETERNA
# nodes). Set to a long random string; e.g.: openssl rand -hex 32
RODA_DISTRIBUTED_API_SECRET=change-me

# ---------------------------------------------------------------------------
# SMTP — outgoing email
# ---------------------------------------------------------------------------

EMAIL_FROM=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# ---------------------------------------------------------------------------
# Solr tuning
# ---------------------------------------------------------------------------

# Java heap size for Solr (e.g. 2g, 4g).
SOLR_HEAP=2g

# Number of Solr shards per collection.
SOLR_NUM_SHARDS=4

# Number of replicas per shard (set >1 for high availability with multiple Solr nodes).
SOLR_REPLICATION_FACTOR=1

# ---------------------------------------------------------------------------
# Optional: SFTP drop folder
# Uncomment the `sftp` service in docker-compose.yaml to use this.
# ---------------------------------------------------------------------------

SFTP_USERNAME=transfer

# ---------------------------------------------------------------------------
# Optional: ACME / Let's Encrypt (Traefik)
# Uncomment the certresolver lines in docker-compose.yaml to use this.
# ---------------------------------------------------------------------------

# ACME_EMAIL=admin@example.com
