---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import { apiGet } from "@/lib/api/client";

const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;
const user = Astro.locals.user;

// Try to load the Welcome HTML theme snippet from the backend
let welcomeHtml = "";
try {
  welcomeHtml = await apiGet<string>("/themes?resource-id=Welcome.html", { cookie: cookieHeader });
} catch {
  // No custom welcome HTML — use default
}
---
<script>
  // Legacy GWT hash-based URL redirect
  // GWT served the app at /#<route> — translate to clean Astro URLs
  (function () {
    const hash = window.location.hash.replace(/^#\/?/, "");
    if (!hash) return;

    const rules: Array<[RegExp, (m: RegExpMatchArray) => string]> = [
      [/^welcome$/, () => "/"],
      [/^login$/, () => "/login"],
      [/^browse\/AIP\/(.+)$/, (m) => `/browse/${m[1]}`],
      [/^browse\/representation\/(.+)$/, (m) => `/browse/representation/${m[1]}`],
      [/^browse\/file\/(.+)$/, (m) => `/browse/file/${m[1]}`],
      [/^browse\/dip\/(.+)$/, (m) => `/browse/dip/${m[1]}`],
      [/^browse$/, () => "/browse"],
      [/^search$/, () => "/search"],
      [/^ingest\/transfer$/, () => "/ingest/transfer"],
      [/^ingest\/process\/job\/(.+)$/, (m) => `/ingest/process/${m[1]}`],
      [/^ingest\/process$/, () => "/ingest/process"],
      [/^ingest\/appraisal$/, () => "/ingest/appraisal"],
      [/^ingest$/, () => "/ingest"],
      [/^administration\/user$/, () => "/management/members"],
      [/^administration\/log$/, () => "/management/log"],
      [/^administration\/reporting$/, () => "/management/statistics"],
      [/^administration$/, () => "/management"],
      [/^disposal\/policy$/, () => "/disposal/policy"],
      [/^disposal\/confirmations$/, () => "/disposal/confirmations"],
      [/^disposal$/, () => "/disposal"],
      [/^planning\/riskregister$/, () => "/planning/risks"],
      [/^planning\/riskincidenceregister$/, () => "/planning/incidences"],
      [/^planning\/representation_information_register$/, () => "/planning/representation-information"],
      [/^planning\/events$/, () => "/planning/events"],
      [/^planning\/agents$/, () => "/planning/agents"],
      [/^planning$/, () => "/planning"],
      [/^profile$/, () => "/auth/profile"],
      [/^register$/, () => "/auth/register"],
      [/^process$/, () => "/process"],
      [/^redactor\/(.+)$/, (m) => `/redactor/${m[1]}`],
      [/^relation\/(.+)$/, (m) => `/relation/${m[1]}`],
    ];

    for (const [pattern, build] of rules) {
      const match = hash.match(pattern);
      if (match) {
        window.location.replace(build(match));
        return;
      }
    }
  })();
</script>

<AdminLayout title="Welcome">
  {welcomeHtml ? (
    <Fragment set:html={welcomeHtml} />
  ) : (
    <div class="max-w-2xl mx-auto py-12 text-center">
      <h1 class="text-3xl font-bold text-[var(--color-primary)] mb-4">Welcome to ETERNA</h1>
      <p class="text-gray-600 mb-8">
        ETERNA is an open-source digital preservation repository implementing the OAIS reference model.
      </p>
      {user && (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8 text-left">
          <a href="/browse" class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm transition-all">
            <div class="text-2xl mb-2">🗂️</div>
            <div class="font-medium text-gray-800">Browse</div>
            <div class="text-sm text-gray-500 mt-1">Browse the archive</div>
          </a>
          <a href="/search" class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm transition-all">
            <div class="text-2xl mb-2">🔍</div>
            <div class="font-medium text-gray-800">Search</div>
            <div class="text-sm text-gray-500 mt-1">Search across content</div>
          </a>
          <a href="/ingest/transfer" class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm transition-all">
            <div class="text-2xl mb-2">📥</div>
            <div class="font-medium text-gray-800">Ingest</div>
            <div class="text-sm text-gray-500 mt-1">Submit new content</div>
          </a>
        </div>
      )}
    </div>
  )}
</AdminLayout>
