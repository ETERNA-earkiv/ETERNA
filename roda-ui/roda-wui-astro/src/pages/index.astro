---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import { apiGet } from "@/lib/api/client";

const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;
const user = Astro.locals.user;

// Try to load the Welcome HTML theme snippet from the backend
let welcomeHtml = "";
try {
  welcomeHtml = await apiGet<string>("/themes?resource-id=Welcome.html", { cookie: cookieHeader });
} catch {
  // No custom welcome HTML — use default
}
---
<AdminLayout title="Welcome">
  {welcomeHtml ? (
    <Fragment set:html={welcomeHtml} />
  ) : (
    <div class="max-w-2xl mx-auto py-12 text-center">
      <h1 class="text-3xl font-bold text-[var(--color-primary)] mb-4">Welcome to ETERNA</h1>
      <p class="text-gray-600 mb-8">
        ETERNA is an open-source digital preservation repository implementing the OAIS reference model.
      </p>
      {user && (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8 text-left">
          <a href="/browse" class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm transition-all">
            <div class="text-2xl mb-2">🗂️</div>
            <div class="font-medium text-gray-800">Browse</div>
            <div class="text-sm text-gray-500 mt-1">Browse the archive</div>
          </a>
          <a href="/search" class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm transition-all">
            <div class="text-2xl mb-2">🔍</div>
            <div class="font-medium text-gray-800">Search</div>
            <div class="text-sm text-gray-500 mt-1">Search across content</div>
          </a>
          <a href="/ingest/transfer" class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm transition-all">
            <div class="text-2xl mb-2">📥</div>
            <div class="font-medium text-gray-800">Ingest</div>
            <div class="text-sm text-gray-500 mt-1">Submit new content</div>
          </a>
        </div>
      )}
    </div>
  )}
</AdminLayout>
