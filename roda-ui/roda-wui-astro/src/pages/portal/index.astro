---
import PortalLayout from "@/components/layout/PortalLayout.astro";
import { apiGet } from "@/lib/api/client";

const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;
let welcomeHtml = "";
try {
  welcomeHtml = await apiGet<string>("/themes?resource-id=WelcomePortal.html", { cookie: cookieHeader });
} catch { /* no custom HTML */ }
---
<PortalLayout title="Welcome">
  {welcomeHtml ? (
    <Fragment set:html={welcomeHtml} />
  ) : (
    <div class="py-12 text-center max-w-2xl mx-auto">
      <h1 class="text-3xl font-bold text-[var(--color-primary)] mb-4">ETERNA Archive</h1>
      <p class="text-gray-600 mb-8">
        Welcome to the ETERNA digital preservation repository. Browse or search the archive to find preserved records.
      </p>
      <div class="flex justify-center gap-4">
        <a href="/portal/browse" class="px-6 py-3 bg-[var(--color-primary)] text-white rounded-lg hover:bg-[var(--color-primary-dark)] transition-colors">
          Browse archive
        </a>
        <a href="/portal/search" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
          Search
        </a>
      </div>
    </div>
  )}
</PortalLayout>
