---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import UserForm from "@/components/management/UserForm.tsx";
import { apiGet } from "@/lib/api/client";

const { userId } = Astro.params;
const cookieHeader = Astro.request.headers.get("cookie") ?? undefined;

interface RodaUser {
  id: string;
  name: string;
  fullname?: string;
  email?: string;
  active?: boolean;
}

let user: RodaUser | null = null;
try {
  user = await apiGet<RodaUser>(`/members/users/${userId}`, { cookie: cookieHeader });
} catch (e: unknown) {
  if ((e as { status?: number }).status === 404 || (e as { status?: number }).status === 403) {
    return Astro.redirect("/management/members");
  }
  throw e;
}

if (!user) return Astro.redirect("/management/members");

const breadcrumb = [
  { label: "Administration", href: "/management" },
  { label: "Users and groups", href: "/management/members" },
  { label: user.name },
];
---
<AdminLayout title={user.name} breadcrumb={breadcrumb}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-800">{user.name}</h1>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
      <UserForm userId={userId} client:load />
    </div>
  </div>
</AdminLayout>
