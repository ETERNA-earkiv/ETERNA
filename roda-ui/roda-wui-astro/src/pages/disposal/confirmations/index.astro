---
import AdminLayout from "@/components/layout/AdminLayout.astro";
---
<AdminLayout
  title="Disposal confirmations"
  breadcrumb={[{ label: "Disposal", href: "/disposal" }, { label: "Confirmations" }]}
>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Disposal confirmations</h1>
    <a href="/disposal/confirmations/new" class="px-4 py-2 bg-[var(--color-primary)] text-white text-sm rounded hover:bg-[var(--color-primary-dark)] transition-colors">
      New confirmation
    </a>
  </div>
  <!-- TODO: DisposalConfirmationList island (Phase 5) -->
  <div class="bg-white rounded-lg border border-gray-200 p-8 text-center text-gray-400 shadow-sm">
    <p>Disposal confirmation list coming in Phase 5.</p>
  </div>
</AdminLayout>
