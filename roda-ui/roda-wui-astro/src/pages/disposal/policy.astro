---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import DisposalPolicyTabs from "@/components/disposal/DisposalPolicyTabs.tsx";
---
<AdminLayout
  title="Disposal policy"
  breadcrumb={[{ label: "Disposal", href: "/disposal" }, { label: "Policy" }]}
>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Disposal policy</h1>
    <div class="flex gap-2">
      <a href="/disposal/schedules/new" class="px-4 py-2 bg-[var(--color-primary)] text-white text-sm rounded hover:bg-[var(--color-primary-dark)] transition-colors">
        New schedule
      </a>
      <a href="/disposal/holds/new" class="px-4 py-2 border border-gray-300 text-gray-700 text-sm rounded hover:bg-gray-50 transition-colors">
        New hold
      </a>
      <a href="/disposal/rules/new" class="px-4 py-2 border border-gray-300 text-gray-700 text-sm rounded hover:bg-gray-50 transition-colors">
        New rule
      </a>
    </div>
  </div>
  <DisposalPolicyTabs client:load />
</AdminLayout>
