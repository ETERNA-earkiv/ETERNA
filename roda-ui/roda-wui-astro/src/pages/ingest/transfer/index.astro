---
import AdminLayout from "@/components/layout/AdminLayout.astro";
---
<AdminLayout title="Transfer" breadcrumb={[{ label: "Ingest", href: "/ingest" }, { label: "Transfer" }]}>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Transfer</h1>
    <a href="/ingest/transfer/upload" class="px-4 py-2 bg-[var(--color-primary)] text-white text-sm rounded hover:bg-[var(--color-primary-dark)] transition-colors">
      Upload SIP
    </a>
  </div>
  <!-- TODO: TransferredResourceList island (Phase 2) -->
  <div class="bg-white rounded-lg border border-gray-200 p-8 text-center text-gray-400 shadow-sm">
    <p>Transfer resource list coming in Phase 2.</p>
  </div>
</AdminLayout>
