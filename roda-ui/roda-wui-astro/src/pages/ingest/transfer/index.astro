---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import TransferredResourceList from "@/components/ingest/TransferredResourceList.tsx";

const parentId = Astro.url.searchParams.get("parentId") ?? undefined;
const breadcrumb = [
  { label: "Ingest", href: "/ingest" },
  { label: "Transfer" },
];
---
<AdminLayout title="Transfer" breadcrumb={breadcrumb}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-800">Transfer</h1>
      <a
        href="/ingest/transfer/upload"
        class="px-4 py-2 bg-[var(--color-primary)] text-white text-sm rounded hover:bg-[var(--color-primary-dark)] transition-colors"
      >
        Upload SIP
      </a>
    </div>
    <TransferredResourceList parentId={parentId} client:load />
  </div>
</AdminLayout>
