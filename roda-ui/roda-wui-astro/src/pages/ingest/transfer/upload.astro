---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import FileUpload from "@/components/ingest/FileUpload.tsx";

const breadcrumb = [
  { label: "Ingest", href: "/ingest" },
  { label: "Transfer", href: "/ingest/transfer" },
  { label: "Upload SIP" },
];
---
<AdminLayout title="Upload SIP" breadcrumb={breadcrumb}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-800">Upload SIP</h1>
      <a href="/ingest/transfer" class="text-sm text-gray-500 hover:text-gray-700">← Back to Transfer</a>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
      <FileUpload client:load />
    </div>
  </div>
</AdminLayout>
