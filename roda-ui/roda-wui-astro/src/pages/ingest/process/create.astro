---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import JobCreationWizard from "@/components/ingest/JobCreationWizard.tsx";

const ids = Astro.url.searchParams.get("ids") ?? "";
const selectedIds = ids ? ids.split(",").filter(Boolean) : [];

const breadcrumb = [
  { label: "Ingest", href: "/ingest" },
  { label: "Process", href: "/ingest/process" },
  { label: "New job" },
];
---
<AdminLayout title="New ingest job" breadcrumb={breadcrumb}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-800">New ingest job</h1>
      <a href="/ingest/process" class="text-sm text-gray-500 hover:text-gray-700">← Back to Process</a>
    </div>
    {selectedIds.length > 0 && (
      <div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-3 text-sm text-blue-700">
        {selectedIds.length} transferred resource{selectedIds.length !== 1 ? "s" : ""} selected for ingest.
      </div>
    )}
    <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
      <JobCreationWizard selectedIds={selectedIds} client:load />
    </div>
  </div>
</AdminLayout>
