---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import JobList from "@/components/ingest/JobList.tsx";
---
<AdminLayout title="Ingest process" breadcrumb={[{ label: "Ingest", href: "/ingest" }, { label: "Process" }]}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-800">Ingest process</h1>
      <a
        href="/ingest/process/create"
        class="px-4 py-2 bg-[var(--color-primary)] text-white text-sm rounded hover:bg-[var(--color-primary-dark)] transition-colors"
      >
        New job
      </a>
    </div>
    <JobList pluginType="INGEST" client:load />
  </div>
</AdminLayout>
