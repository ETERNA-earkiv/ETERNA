---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import TransferredResourceList from "@/components/ingest/TransferredResourceList.tsx";
---
<AdminLayout title="Appraisal" breadcrumb={[{ label: "Ingest", href: "/ingest" }, { label: "Appraisal" }]}>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Appraisal</h1>
    <p class="text-sm text-gray-500">Review transferred resources before starting ingest.</p>
  </div>
  <TransferredResourceList client:load />
</AdminLayout>
