---
import AdminLayout from "@/components/layout/AdminLayout.astro";
---
<AdminLayout title="Server error">
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center">
    <p class="text-6xl font-bold text-gray-200 mb-4">500</p>
    <h1 class="text-2xl font-bold text-gray-800 mb-2">Internal server error</h1>
    <p class="text-gray-500 mb-8">An unexpected error occurred. Please try again later.</p>
    <div class="flex gap-3">
      <button onclick="window.location.reload()" class="px-4 py-2 bg-[var(--color-primary)] text-white text-sm rounded hover:bg-[var(--color-primary-dark)] transition-colors">
        Retry
      </button>
      <a href="/" class="px-4 py-2 border border-gray-300 text-sm rounded hover:bg-gray-50 transition-colors">
        Go home
      </a>
    </div>
  </div>
</AdminLayout>
