---
import AdminLayout from "@/components/layout/AdminLayout.astro";
import RiskIncidenceList from "@/components/planning/RiskIncidenceList.tsx";

const riskId = Astro.url.searchParams.get("riskId") ?? undefined;
---
<AdminLayout
  title="Risk incidences"
  breadcrumb={[{ label: "Planning", href: "/planning" }, { label: "Risk incidences" }]}
>
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Risk incidences</h1>
  <RiskIncidenceList riskId={riskId} client:load />
</AdminLayout>
