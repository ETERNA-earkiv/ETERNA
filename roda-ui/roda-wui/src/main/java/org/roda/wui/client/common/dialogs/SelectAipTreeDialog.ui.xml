<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder" xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with field='messages' type='config.i18n.client.ClientMessages' />

	<g:FlowPanel addStyleNames="wrapper skip_padding">
		<g:FlowPanel addStyleNames="wui-dialog-layout selectAipTree">
			<g:FlowPanel addStyleNames="catalogTreeFilter">
				<g:TextBox ui:field="filterInput" styleName="catalogTreeFilterInput" />
			</g:FlowPanel>
			<g:FlowPanel addStyleNames="selectAipTreeBodyScroll">
				<g:FlowPanel ui:field="treeBody" />
				<g:FlowPanel ui:field="searchResults" />
			</g:FlowPanel>
			<g:FlowPanel addStyleNames="wui-dialog-layout-footer">
				<g:Button addStyleNames="btn btn-link" ui:field="cancelButton">
					<ui:text from='{messages.selectAipCancelButton}' />
				</g:Button>
				<g:Button addStyleNames="btn btn-play selectAipTreeEmptyParentButton" ui:field="emptyParentButton">
					<ui:text from='{messages.selectAipEmptyParentButton}' />
				</g:Button>
				<g:Button addStyleNames="btn btn-play" ui:field="selectButton">
					<ui:text from='{messages.selectAipSelectButton}' />
				</g:Button>
			</g:FlowPanel>
		</g:FlowPanel>
	</g:FlowPanel>
</ui:UiBinder>
