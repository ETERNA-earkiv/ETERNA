<?xml version="1.0" encoding="utf-8"?>
<erms xmlns="https://DILCIS.eu/XML/ERMS"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="https://DILCIS.eu/XML/ERMS ../schemas/erms_v3.xsd">
  <control>
    <identification identificationType="{{#if identificationType}}{{identificationType}}{{else}}local{{/if}}">{{identification}}</identification>
    <maintenanceInformation>
      <maintenanceStatus value="created"/>
      <maintenanceAgency>
        <agencyName>{{agencyName}}</agencyName>
      </maintenanceAgency>
      <maintenanceHistory>
        <maintenanceEvent>
          <eventType value="created"/>
          <eventDateTime>{{#if openDate}}{{openDate}}T00:00:00{{else}}2001-01-01T00:00:00{{/if}}</eventDateTime>
          <agent><name>ETERNA</name></agent>
        </maintenanceEvent>
      </maintenanceHistory>
    </maintenanceInformation>
  </control>
  <aggregations>
    <aggregation systemIdentifier="{{systemIdentifier}}" aggregationType="caseFile">
      <objectId>{{objectId}}</objectId>
      {{~#if extraId~}}
      <extraId extraIdType="{{#if extraIdType}}{{extraIdType}}{{else}}other{{/if}}">{{extraId}}</extraId>
      {{~/if~}}
      {{~#if informationClass~}}
      <informationClass>{{informationClass}}</informationClass>
      {{~/if~}}
      {{~#if securityClass~}}
      <securityClass>{{securityClass}}</securityClass>
      {{~/if~}}
      {{~#if classification~}}
      <classification{{#if classificationCode}} classificationCode="{{classificationCode}}"{{/if}}>{{classification}}</classification>
      {{~/if~}}
      {{~#if parentAggregationId~}}
      <parentAggregationId>{{parentAggregationId}}</parentAggregationId>
      {{~/if~}}
      {{~#if hierarchicalParentClassId~}}
      <hierarchicalParentClassId>{{hierarchicalParentClassId}}</hierarchicalParentClassId>
      {{~/if~}}
      {{~#if levelName~}}
      <levelName>{{levelName}}</levelName>
      {{~/if~}}
      {{~#ifCond "||" keyword1 keyword2~}}
      <keywords>
        {{~#if keyword1~}}<keyword>{{keyword1}}</keyword>{{~/if~}}
        {{~#if keyword2~}}<keyword>{{keyword2}}</keyword>{{~/if~}}
      </keywords>
      {{~/ifCond~}}
      {{~#if title~}}
      <title>{{title}}</title>
      {{~/if~}}
      {{~#if otherTitle~}}
      <otherTitle titleType="{{#if otherTitleType}}{{otherTitleType}}{{else}}other{{/if}}">{{otherTitle}}</otherTitle>
      {{~/if~}}
      {{~#if subject1~}}<subject>{{subject1}}</subject>{{~/if~}}
      {{~#if subject2~}}<subject>{{subject2}}</subject>{{~/if~}}
      {{~#if status~}}
      <status value="{{status}}"/>
      {{~/if~}}
      {{~#if relation1~}}
      <relation relationType="{{#if relation1Type}}{{relation1Type}}{{else}}reference{{/if}}">{{relation1}}</relation>
      {{~/if~}}
      {{~#if relation2~}}
      <relation relationType="{{#if relation2Type}}{{relation2Type}}{{else}}reference{{/if}}">{{relation2}}</relation>
      {{~/if~}}
      {{~#if restrictionRegulation~}}
      <restriction restrictionType="{{#if restrictionType}}{{restrictionType}}{{else}}confidential{{/if}}">
        {{~#if restrictionExplanatoryText~}}<explanatoryText>{{restrictionExplanatoryText}}</explanatoryText>{{~/if~}}
        <regulation>{{restrictionRegulation}}</regulation>
      </restriction>
      {{~/if~}}
      {{~#ifCond "||" disposalScheduleId disposalAction disposalPeriod disposalMandate disposalDescription~}}
      <disposal>
        {{~#if disposalScheduleId~}}<disposalScheduleId>{{disposalScheduleId}}</disposalScheduleId>{{~/if~}}
        {{~#if disposalAction~}}<disposalAction>{{disposalAction}}</disposalAction>{{~/if~}}
        {{~#if disposalPeriod~}}<disposalPeriod>{{disposalPeriod}}</disposalPeriod>{{~/if~}}
        {{~#if disposalMandate~}}<disposalMandate>{{disposalMandate}}</disposalMandate>{{~/if~}}
        {{~#if disposalDescription~}}<disposalDescription>{{disposalDescription}}</disposalDescription>{{~/if~}}
        <dates><date dateType="other">2001-01-01T00:00:00</date></dates>
      </disposal>
      {{~/ifCond~}}
      {{~#ifCond "||" agent1Name agent2Name~}}
      <agents>
        {{~#if agent1Name~}}
        <agent>
          <name>{{agent1Name}}</name>
          {{~#if agent1Organisation~}}<organisation>{{agent1Organisation}}</organisation>{{~/if~}}
          {{~#if agent1Role~}}<role>{{agent1Role}}</role>{{~/if~}}
        </agent>
        {{~/if~}}
        {{~#if agent2Name~}}
        <agent>
          <name>{{agent2Name}}</name>
          {{~#if agent2Organisation~}}<organisation>{{agent2Organisation}}</organisation>{{~/if~}}
          {{~#if agent2Role~}}<role>{{agent2Role}}</role>{{~/if~}}
        </agent>
        {{~/if~}}
      </agents>
      {{~/ifCond~}}
      {{~#if description~}}
      <description>{{description}}</description>
      {{~/if~}}
      {{~#ifCond "||" openDate closeDate~}}
      <dates>
        {{~#if openDate~}}<date dateType="opening_date">{{openDate}}T00:00:00</date>{{~/if~}}
        {{~#if closeDate~}}<date dateType="closed">{{closeDate}}T00:00:00</date>{{~/if~}}
      </dates>
      {{~/ifCond~}}
      {{~#if archivalHistory~}}
      <archivalHistory>
        <historyLine>{{archivalHistory}}</historyLine>
      </archivalHistory>
      {{~/if~}}
      {{~#if dispatchMode~}}
      <dispatchMode>{{dispatchMode}}</dispatchMode>
      {{~/if~}}
      {{~#if access~}}
      <access>{{access}}</access>
      {{~/if~}}
      {{~#if physicalLocation~}}
      <physicalLocations>
        <physicalLocation>
          <currentLocation>{{physicalLocation}}</currentLocation>
        </physicalLocation>
      </physicalLocations>
      {{~/if~}}
      {{~#if note~}}
      <notes>
        <note{{#if noteType}} noteType="{{noteType}}"{{/if}}>{{note}}</note>
      </notes>
      {{~/if~}}
    </aggregation>
  </aggregations>
</erms>
