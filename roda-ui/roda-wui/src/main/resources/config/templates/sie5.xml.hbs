{{~field name="supplierName"        order='1' auto-generate='title' labeli18n="crosswalks.dissemination.html.sie5.supplierName"        label="{\"en\": \"Supplier name\", \"sv\": \"Leverantör\"}"              xpath="//*:Supplier[1]/@name"}}
{{~field name="supplierInvoiceId"           order='2'                          labeli18n="crosswalks.dissemination.html.sie5.supplierInvoiceId"            label="{\"en\": \"Supplier invoice number\", \"sv\": \"Leverantörens fakturanummer\"}"          xpath="//*:SupplierInvoice[1]/@supplierInvoiceId"}}
{{~field name="invoiceId"           order='3'                          labeli18n="crosswalks.dissemination.html.sie5.invoiceId"            label="{\"en\": \"Invoice number\", \"sv\": \"Fakturanummer\"}"          xpath="//*:SupplierInvoice[1]/@id"}}
{{~field name="invoiceDate"         order='4' type='date'              labeli18n="crosswalks.dissemination.html.sie5.invoiceDate"          label="{\"en\": \"Invoice date\", \"sv\": \"Fakturadatum\"}"             xpath="//*:SupplierInvoice[1]/@invoiceDate"}}
{{~field name="supplierOrgId"       order='5'                          labeli18n="crosswalks.dissemination.html.sie5.supplierOrgId"        label="{\"en\": \"Supplier org. number\", \"sv\": \"Org.nummer\"}"       xpath="//*:Supplier[1]/@organizationId"}}
{{~field name="currency"            order='6'                          labeli18n="crosswalks.dissemination.html.sie5.currency"             label="{\"en\": \"Currency\", \"sv\": \"Valuta\"}"                       xpath="//*:SupplierInvoice[1]/@currency"}}
{{~field name="approvedBy"          order='7'                          labeli18n="crosswalks.dissemination.html.sie5.approvedBy"           label="{\"en\": \"Approved by\", \"sv\": \"Godkänd av\"}"               xpath="//*:SupplierInvoice[1]/@approvedBy"}}
{{~field name="approvedDate"        order='8' type='date'              labeli18n="crosswalks.dissemination.html.sie5.approvedDate"         label="{\"en\": \"Approved date\", \"sv\": \"Godkänd datum\"}"           xpath="//*:SupplierInvoice[1]/@approvedDate"}}
{{~field name="paymentDate"         order='9' type='date'              labeli18n="crosswalks.dissemination.html.sie5.paymentDate"          label="{\"en\": \"Payment date\", \"sv\": \"Betalningsdatum\"}"          xpath="//*:SupplierInvoice[1]/@paymentDate"}}
{{~field name="fiscalYearStart"     order='10' type='date'              labeli18n="crosswalks.dissemination.html.sie5.fiscalYearStart"      label="{\"en\": \"Fiscal year start\", \"sv\": \"Räkenskapsår start\"}"  xpath="//*:FiscalYear[1]/@start"}}
{{~field name="fiscalYearEnd"       order='11' type='date'              labeli18n="crosswalks.dissemination.html.sie5.fiscalYearEnd"        label="{\"en\": \"Fiscal year end\", \"sv\": \"Räkenskapsår slut\"}"     xpath="//*:FiscalYear[1]/@end"~}}
<?xml version="1.0" encoding="UTF-8"?>
<sie:SIE xmlns:sie="http://www.sie.se/sie5"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.sie.se/sie5 ../schemas/sie5.xsd">
  <sie:FileInfo>
    <sie:FileCreation time=""/>
  </sie:FileInfo>
  <sie:Company clientId="" name="">
    {{~#if fiscalYearStart}}
    <sie:FiscalYears>
      <sie:FiscalYear id="1" start="{{fiscalYearStart}}" end="{{#if fiscalYearEnd}}{{fiscalYearEnd}}{{else}}{{fiscalYearStart}}{{/if}}" primaryYear="true"/>
    </sie:FiscalYears>
    {{~/if}}
    <sie:Suppliers>
      <sie:Supplier id="1" name="{{#if supplierName}}{{supplierName}}{{/if}}" organizationId="{{#if supplierOrgId}}{{supplierOrgId}}{{/if}}"/>
    </sie:Suppliers>
    <sie:SupplierInvoices>
      <sie:SupplierInvoice id="1" supplierRef="1"
        supplierInvoiceId="{{#if supplierInvoiceId}}{{supplierInvoiceId}}{{/if}}"
        id="{{#if invoiceId}}{{invoiceId}}{{/if}}"
        invoiceDate="{{#if invoiceDate}}{{invoiceDate}}{{/if}}"
        currency="{{#if currency}}{{currency}}{{/if}}"
        approvedBy="{{#if approvedBy}}{{approvedBy}}{{/if}}"
        approvedDate="{{#if approvedDate}}{{approvedDate}}{{/if}}"
        paymentDate="{{#if paymentDate}}{{paymentDate}}{{/if}}"/>
    </sie:SupplierInvoices>
  </sie:Company>
</sie:SIE>
